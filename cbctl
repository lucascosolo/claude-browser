#!/usr/bin/env python3
"""cbctl -- drive a running claude-browser from the shell.

    cbctl open https://example.com
    cbctl text
    cbctl links | jq -r '.links[].href'
    cbctl eval 'document.title'
    cbctl shot /tmp/page.png

Everything prints JSON on stdout, so it composes with jq. Exit status is 1 when
the browser reports ok:false, which makes `cbctl click .submit && cbctl text`
behave the way a shell user expects.

The subcommands are built from claudebrowser.api.OPS rather than written out --
the same table control.py serves and cb-mcp exposes. When they were three lists,
`cb-mcp` silently lacked `forward` and `wait`.
"""

import argparse
import json
import sys
from pathlib import Path

# Resolve through the symlink -- these are installed into ~/.local/bin as links.
sys.path.insert(0, str(Path(__file__).resolve().parent))

from claudebrowser import api, client  # noqa: E402


def build_parser():
    parser = argparse.ArgumentParser(
        prog="cbctl", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--tab", type=int, help="tab id (default: the focused tab)")
    sub = parser.add_subparsers(dest="cmd", required=True)

    alias_of = {target: alias for alias, target in api.CLI_ALIASES.items()}
    for op in api.OPS:
        command = sub.add_parser(alias_of.get(op.name, op.name), help=op.summary)
        command.set_defaults(op=op)
        for param in op.params:
            if param.cli == "arg":
                command.add_argument(param.name, help=param.help or None)
            elif param.cli == "optarg":
                command.add_argument(param.name, nargs="?", help=param.help or None)
            elif param.kind == "boolean":
                command.add_argument("--" + param.name, action="store_true",
                                     help=param.help)
            else:
                command.add_argument("--" + param.name, help=param.help)
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    op = args.op

    params = {p.name: getattr(args, p.name, None) for p in op.params}
    if op.tab:
        params["tab"] = args.tab

    # `screenshot` with no path streams the PNG itself rather than JSON.
    raw = op.name == "screenshot" and not params.get("path")
    result = client.call(op.route, op.method, params, raw=raw)
    if raw and "_raw" in result:
        sys.stdout.buffer.write(result["_raw"])
        return 0

    # A browser that is not running is an operator problem, not page data: it
    # goes to stderr so a `cbctl text | jq` pipeline fails loudly instead of
    # feeding jq an error object that looks like a result.
    if not result.get("ok", True) and "cannot reach claude-browser" in str(
            result.get("error", "")):
        print(result["error"], file=sys.stderr)
        return 1

    print(json.dumps(result, indent=2, ensure_ascii=False))
    return 0 if result.get("ok", True) else 1


if __name__ == "__main__":
    sys.exit(main())
