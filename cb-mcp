#!/usr/bin/env python3
"""cb-mcp -- expose the browser to Claude Code as MCP tools.

    claude mcp add -s user browser -- /path/to/claude-browser/cb-mcp

Stdio JSON-RPC, standard library only. This is a thin translation layer: every
tool maps to one control-API route from claudebrowser.api.OPS -- the same table
that generates the HTTP routes and `cbctl`'s subcommands -- and the browser is
the thing that actually holds state.

**It starts the browser if one is not running.** A tool that answers "start it
with `cb`" is a tool the model has to be taught about before it works, which is
exactly what made the Chrome extension the path of least resistance. Set
`CB_AUTOSTART=0` to opt out and get the old message back.
"""

import json
import sys
from pathlib import Path

# Resolve through the symlink -- installed into ~/.local/bin as one.
sys.path.insert(0, str(Path(__file__).resolve().parent))

from claudebrowser import api, client  # noqa: E402

PROTOCOL = "2025-06-18"


def send(message):
    sys.stdout.write(json.dumps(message) + "\n")
    sys.stdout.flush()


def reply(req_id, result):
    send({"jsonrpc": "2.0", "id": req_id, "result": result})


def fail(req_id, code, message):
    send({"jsonrpc": "2.0", "id": req_id, "error": {"code": code, "message": message}})


def invoke(name, arguments):
    """Run one tool. Starts the browser on the first call if it is not up."""
    op = api.BY_NAME.get(name.removeprefix("browser_"))
    if op is None or not op.mcp:
        return None
    if not client.is_running(timeout=2) and not client.autostart():
        return {"ok": False, "error": client.unreachable("not running")}
    return client.call(op.route, op.method, arguments)


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            request = json.loads(line)
        except json.JSONDecodeError:
            continue

        method = request.get("method")
        req_id = request.get("id")
        if req_id is None:
            continue  # a notification; nothing to answer

        if method == "initialize":
            asked = (request.get("params") or {}).get("protocolVersion")
            reply(req_id, {
                "protocolVersion": asked or PROTOCOL,
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "claude-browser", "version": "0.2.0"},
            })
        elif method == "tools/list":
            reply(req_id, {"tools": api.mcp_tools()})
        elif method == "tools/call":
            params = request.get("params") or {}
            name = params.get("name") or ""
            result = invoke(name, params.get("arguments") or {})
            if result is None:
                fail(req_id, -32602, "unknown tool %r" % name)
                continue
            reply(req_id, {
                "content": [{"type": "text",
                             "text": json.dumps(result, indent=2, ensure_ascii=False)}],
                "isError": not result.get("ok", True),
            })
        elif method == "ping":
            reply(req_id, {})
        else:
            fail(req_id, -32601, "method not found: %s" % method)


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        pass
